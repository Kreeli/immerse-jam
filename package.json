{
  "name": "immerse-jam",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Local music separation and synchronized practice workspace",
  "author": "Immerse Jam",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build && node scripts/prepare-notices.cjs && node scripts/copy-assets.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:backend": "node scripts/test-backend.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "package": "npm run build && node scripts/package.cjs nsis",
    "package:portable": "npm run build && node scripts/package.cjs dir"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@soundtouchjs/audio-worklet": "2.1.1",
    "@tonejs/midi": "2.0.28",
    "adm-zip": "0.5.16",
    "archiver": "7.0.1",
    "fflate": "0.8.2",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "1.63.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.immersejam.desktop",
    "productName": "Immerse Jam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "vendor",
        "to": "vendor"
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Immerse Jam",
      "runAfterFinish": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
